{
  "name": "@openscreeps/game",
  "version": "0.0.0",
  "private": true,
  "description": "Headless Screeps-compatible game world: generation, NPCs, maintenance, players and ticks",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "reference-versions.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/**/*.test.ts",
    "conformance:setup": "node conformance/setup.ts",
    "conformance": "node conformance/backend.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "license": "ISC",
  "dependencies": {
    "@openscreeps/engine": "github:openscreeps/engine#d9c5a8f50d654273fa5e5645f05afca65e6c3274"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "isolated-vm@7.0.1": true,
    "github:openscreeps/engine#d9c5a8f50d654273fa5e5645f05afca65e6c3274": true
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
